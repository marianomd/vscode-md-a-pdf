{
  "name": "md-a-pdf",
  "displayName": "Beautiful Markdown to PDF",
  "description": "Beautiful Markdown to PDF: export the open .md file to PDF with Mermaid diagrams, using the installed Edge/Chrome.",
  "publisher": "local",
  "version": "1.0.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "mdAPdf.export",
        "title": "Beautiful Markdown to PDF: Export",
        "icon": "$(file-pdf)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdAPdf.export",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "mdAPdf.export",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mdAPdf.export",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdAPdf.export",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": {
      "title": "Beautiful Markdown to PDF",
      "properties": {
        "mdAPdf.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python executable. Empty: tries python, py -3 and python3. Requires the markdown library (pip install markdown)."
        },
        "mdAPdf.browserPath": {
          "type": "string",
          "default": "",
          "description": "Path to msedge.exe or chrome.exe. Empty: detected automatically."
        },
        "mdAPdf.layout": {
          "type": "string",
          "enum": [
            "auto",
            "tall",
            "a4"
          ],
          "default": "auto",
          "description": "auto: one tall page if the .md has Mermaid diagrams, A4 pages otherwise. tall: always one tall page. a4: always A4 pages."
        },
        "mdAPdf.openAfterExport": {
          "type": "boolean",
          "default": true,
          "description": "Offer to open the PDF when it is done."
        }
      }
    }
  }
}
